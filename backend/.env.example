# Copy this file, name the copy ".env" and fill in your own values.
# You find the three Supabase values in your Supabase project:
# Project Settings -> API (or "API Keys").

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Must be the same number as API_URL in frontend/js/config.js
PORT=5050
