# Copy this file, name the copy ".env" and fill in your own values.
# You find the three Supabase values in your Supabase project:
# Project Settings -> API (or "API Keys").

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Must be the same number as API_URL in public/js/config.js
PORT=5050

# Optional: confirmation emails (account created, appointment token,
# confirmed, cancelled, completed). Use a Gmail address and its
# 16-letter App password (see SETUP-GUIDE.md, section 8).
SMTP_USER=
SMTP_PASS=
